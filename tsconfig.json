{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
